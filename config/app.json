{
  "configVersion": "1.1",
  "appId": "olaf-builders",
  "site": {
    "publicBaseUrl": null
  },
  "meta": {
    "securityLabel": "LGE Internal Use Only"
  },
  "brand": {
    "stage": "proposal",
    "masterBrand": "OLAF",
    "masterBrandFull": "One LG Autonomous Factory",
    "program": "OLAF AXellerator",
    "community": "OLAF Builders",
    "messages": {
      "master": "Accelerate People. Build Autonomous Factory.",
      "campaign": "Learn Less. Build More.",
      "core": "배우기 위해 프로젝트를 하는 것이 아니라, 프로젝트를 성공시키기 위해 필요한 것을 배운다."
    }
  },
  "cohort": {
    "code": "2026-1",
    "name": "OLAF AXellerator 01"
  },
  "labs": [
    {
      "code": "PA",
      "name": "Physical AI",
      "tagline": "Sense · Move · Act",
      "groups": [
        "PA-1",
        "PA-2",
        "PA-3"
      ],
      "keywords": [
        "Robot",
        "AMR",
        "Vision",
        "Sensor",
        "Safety"
      ]
    },
    {
      "code": "AA",
      "name": "Agentic AI",
      "tagline": "Reason · Decide · Orchestrate",
      "groups": [
        "AA-1",
        "AA-2"
      ],
      "keywords": [
        "Agent",
        "Knowledge",
        "Data",
        "Workflow"
      ]
    },
    {
      "code": "DT",
      "name": "Digital Twin",
      "tagline": "Model · Simulate · Validate",
      "groups": [
        "DT-1",
        "DT-2"
      ],
      "keywords": [
        "Modeling",
        "Simulation",
        "Virtual Commissioning",
        "Optimization"
      ]
    }
  ],
  "roles": {
    "builder": {
      "label": "Builder",
      "idPattern": "^[A-Z][A-Z0-9-]{1,19}$"
    },
    "master": {
      "label": "Master",
      "idPattern": "^MS-[0-9]{2,3}$",
      "scope": "lab"
    },
    "office": {
      "label": "사무국",
      "idPattern": "^OP-[0-9]{2,3}$"
    }
  },
  "menus": {
    "builder": [
      "materials",
      "qcards",
      "board",
      "directory",
      "events",
      "bookmarks"
    ],
    "master": [
      "materials",
      "board",
      "directory",
      "events",
      "bookmarks"
    ],
    "office": [
      "materials",
      "board",
      "directory",
      "events",
      "admin"
    ]
  },
  "menuItems": {
    "materials": {
      "label": "교육 자료",
      "href": "/materials.html"
    },
    "qcards": {
      "label": "질문 카드",
      "href": "/qcard.html"
    },
    "board": {
      "label": "커뮤니티",
      "href": "/board.html"
    },
    "admin": {
      "label": "사무국",
      "href": "/admin/index.html"
    },
    "directory": {
      "label": "멤버",
      "href": "/directory.html"
    },
    "events": {
      "label": "일정",
      "href": "/events.html"
    },
    "bookmarks": {
      "label": "내 저장함",
      "href": "/bookmarks.html"
    },
    "surveys": {
      "label": "설문",
      "href": "/surveys.html"
    }
  },
  "auth": {
    "sessionHours": 8,
    "officeSessionHours": 2,
    "password": {
      "default": { "minLength": 10, "requireMixedClasses": true },
      "builder": { "minLength": 6, "requireMixedClasses": false }
    },
    "cookieName": "olaf_session",
    "rateLimit": {
      "windowMinutes": 10,
      "maxFailures": 20
    }
  },
  "privacy": {
    "employeeIdPattern": "(?<![0-9#\\[])[0-9]{6,7}(?![0-9\\]])",
    "emailPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
    "phonePattern": "(?<![0-9])01[016789][- .]?[0-9]{3,4}[- .]?[0-9]{4}(?![0-9])"
  },
  "roster": {
    "requiredColumns": [
      "person_id",
      "role",
      "name",
      "title",
      "lab",
      "group"
    ],
    "optionalColumns": [
      "assigned",
      "challenge"
    ],
    "dropColumns": [
      "employee_id",
      "emp_no",
      "사번",
      "사원번호",
      "email",
      "e-mail",
      "이메일"
    ],
    "forbiddenColumns": [
      "gap",
      "current",
      "required",
      "evidence",
      "score",
      "level",
      "p2a",
      "code"
    ]
  },
  "materials": {
    "maxPackageMb": 300,
    "maxPages": 150,
    "maxPageKb": 2048,
    "watermarkText": "{community} {cohort} · {label} · 무단 배포 금지"
  },
  "qcards": {
    "closed": false,
    "closedMessage": "질문 카드 제출이 마감되었습니다. 제출하신 질문은 사무국이 후속 답변으로 정리해 안내합니다.",
    "formats": {
      "allowed": [
        "template",
        "free"
      ],
      "default": "template"
    },
    "template": {
      "lead": "내 과제 「{challenge}」에서 {situation}하려는데, 현재 {constraint} 제약이 있다.",
      "defaultAsk": "이 현실 이슈를 해결한 방법론이나 사례가 있나?",
      "minChars": {
        "situation": 5,
        "constraint": 5,
        "ask": 8
      },
      "maxChars": {
        "situation": 120,
        "constraint": 120,
        "ask": 200
      }
    },
    "free": {
      "lead": "내 과제 「{challenge}」 관련 —",
      "minChars": 15,
      "maxChars": 200
    },
    "readAloudSeconds": 40,
    "charsPerSecond": 5,
    "maxQuestionMarks": 1,
    "maxCardsPerPersonPerSession": 3,
    "selectionUnit": "lab",
    "selectionSlots": [
      "대표",
      "예비"
    ]
  },
  "sessions": [
    {
      "code": "DT",
      "title": "DT : 현장 질문에 답하는 시뮬레이터",
      "date": "2026-10-22",
      "leadLab": "DT"
    },
    {
      "code": "AA",
      "title": "AA : 현장 지식으로 행동하는 에이전트",
      "date": "2026-10-22",
      "leadLab": "AA"
    }
  ],
  "visibility": {
    "labLoungeCrossLabRead": true
  },
  "spaces": [
    {
      "code": "notice",
      "per": "none",
      "label": "공지 · Launch",
      "read": "all",
      "write": "operator"
    },
    {
      "code": "lab_lounge",
      "per": "lab",
      "label": "Lab 라운지",
      "read": "lab_scope",
      "write": "lab"
    },
    {
      "code": "group_board",
      "per": "group",
      "label": "그룹 보드",
      "read": "group",
      "write": "group",
      "template": [
        "이번 주 한 일",
        "막힌 점",
        "도움 필요"
      ]
    },
    {
      "code": "master_qa",
      "per": "none",
      "label": "Master Q&A",
      "read": "all",
      "write": "all",
      "acceptAnswers": true,
      "template": [
        "내 과제 맥락",
        "궁금한 점",
        "시도해 본 것"
      ]
    },
    {
      "code": "build_review",
      "per": "none",
      "label": "Build Review",
      "read": "all",
      "write": "all",
      "template": [
        "Problem",
        "Solution",
        "Evidence",
        "Business Impact",
        "Next Scale"
      ]
    },
    {
      "code": "material_qa",
      "per": "none",
      "label": "자료 질문",
      "read": "all",
      "write": "all",
      "acceptAnswers": true,
      "template": [
        "내 과제 맥락",
        "궁금한 점",
        "시도해 본 것"
      ],
      "feature": "materialThreads"
    }
  ],
  "posts": {
    "titleMaxChars": 200,
    "bodyMaxChars": 20000,
    "pageSize": 20,
    "deletedPlaceholder": "작성자가 삭제한 글입니다.",
    "hideReasons": [
      "confidential",
      "personal_info",
      "evaluative",
      "other"
    ],
    "maxPinnedPerSpace": 3
  },
  "backup": {
    "hourLocal": 3,
    "keep": 14
  },
  "logs": {
    "keepDays": 30
  },
  "features": {
    "templates": true,
    "directory": true,
    "pin": true,
    "accept": true,
    "qcardAnswer": true,
    "notifications": true,
    "events": true,
    "digest": true,
    "materialThreads": true,
    "bookmarks": true,
    "tags": true,
    "reports": true,
    "helpful": false,
    "surveys": false
  },
  "directory": {
    "showChallenge": false
  },
  "qcardAnswer": {
    "space": "master_qa",
    "showAsker": false
  },
  "notifications": {
    "defaultLookbackDays": 7,
    "minPollSeconds": 30
  },
  "digest": {
    "defaultDays": 7,
    "maxDays": 30,
    "maxItems": 50
  },
  "events": [
    {
      "date": "2026-10-22",
      "title": "On-Track W/S · 패널 Q&A",
      "kind": "session",
      "note": "DT · AA 세션"
    }
  ],
  "tags": {
    "extra": [
      "Process",
      "Quality",
      "Maintenance"
    ],
    "maxPerPost": 5
  },
  "moderation": {
    "immediateHideReasons": [
      "confidential",
      "personal_info"
    ],
    "reportsPerPersonPerDay": 10,
    "noteMaxChars": 500
  },
  "surveys": {
    "maxOptions": 10,
    "minOptions": 2
  }
}
